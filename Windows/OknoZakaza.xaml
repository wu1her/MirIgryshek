<Window x:Class="MirIgryshek.Windows.OknoZakaza"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MirIgryshek.Windows"
        mc:Ignorable="d"
        Title="OknoZakaza" Height="150" Width="850">
    <StackPanel Orientation="Horizontal">
        <Border BorderThickness="2" BorderBrush="Black" Margin="4">
            <StackPanel Orientation="Vertical" Width="680">
                <TextBlock x:Name="Articul"/>
                <TextBlock x:Name="Status"/>
                <TextBlock x:Name="Pynkt"/>
                <TextBlock x:Name="DataZakaza"/>
            </StackPanel>
        </Border>
        <Border BorderThickness="2" BorderBrush="Black" Margin="4">
            <TextBlock x:Name="DataDostavki"></TextBlock>
        </Border>
    </StackPanel>
</Window>
