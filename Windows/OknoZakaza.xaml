<Window x:Class="MirIgryshek.Windows.OknoZakaza"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказ"
        Height="180"
        Width="850"
        FontFamily="Arial"
        Background="White">

    <Grid Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="150"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                BorderThickness="2"
                BorderBrush="Black"
                Margin="4">
            <StackPanel Margin="5">
                <TextBlock x:Name="Articul" FontWeight="Bold"/>
                <TextBlock x:Name="Status"/>
                <TextBlock x:Name="Pynkt" TextWrapping="Wrap"/>
                <TextBlock x:Name="DataZakaza"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1"
                BorderThickness="2"
                BorderBrush="Black"
                Margin="4">
            <TextBlock x:Name="DataDostavki"
                       Margin="5"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>