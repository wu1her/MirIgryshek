<Window x:Class="MirIgryshek.Windows.Zakazi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказы"
        Width="1000" Height="550"
        FontFamily="Arial"
        Background="White">

    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Margin="0,0,0,10">

            <Button Content="Назад"
                    Click="Back_Click"
                    Margin="5"/>

            <Button x:Name="ZakazAdd"
                    Content="Добавить заказ"
                    Click="ZakazAdd_Click"
                    Visibility="Collapsed"
                    Margin="5"/>

            <Button x:Name="ZakazDelete"
                    Content="Удалить заказ"
                    Click="ZakazDelete_Click"
                    Visibility="Collapsed"
                    Margin="5"/>

            <TextBlock x:Name="UserBlock"
                       VerticalAlignment="Center"
                       Margin="15,0,0,0"/>
        </StackPanel>

        <DataGrid x:Name="SpisokZakazi"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  SelectedValuePath="Nomer"
                  MouseDoubleClick="SpisokZakazi_MouseDoubleClick">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер"
                                    Binding="{Binding Nomer}"/>

                <DataGridTextColumn Header="Пользователь"
                                    Binding="{Binding Login}"/>

                <DataGridTextColumn Header="Товары"
                                    Binding="{Binding Tovar}"/>

                <DataGridTextColumn Header="Пункт выдачи"
                                    Binding="{Binding Pynkt}"/>

                <DataGridTextColumn Header="Статус"
                                    Binding="{Binding Status}"/>

                <DataGridTextColumn Header="Код"
                                    Binding="{Binding Kod}"/>

                <DataGridTextColumn Header="Дата заказа"
                                    Binding="{Binding DataZakaza, StringFormat=dd.MM.yyyy}"/>

                <DataGridTextColumn Header="Дата доставки"
                                    Binding="{Binding DataDostavka, StringFormat=dd.MM.yyyy}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>