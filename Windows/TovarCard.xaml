<UserControl x:Class="MirIgryshek.Windows.TovarCard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MirIgryshek.Windows"
        mc:Ignorable="d"
        
        Height="200" Width="850" Background="{StaticResource Akcent}">
    <DockPanel >
        <Image x:Name="Photo"/>
        <StackPanel Orientation="Vertical">
            <TextBlock x:Name="ManeCardText" />
            <TextBlock x:Name="Opisanie" />
            <TextBlock x:Name="Proizvoditel" />
            <TextBlock x:Name="Postavshik" />
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="Cena" />
                <TextBlock x:Name="CenaSkidka" />
            </StackPanel>
            <TextBlock x:Name="Edinica" />
            <TextBlock x:Name="Kolichestvo" />
        </StackPanel>
    </DockPanel>
</UserControl>
