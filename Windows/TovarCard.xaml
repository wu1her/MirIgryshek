<UserControl x:Class="MirIgryshek.Windows.TovarCard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MirIgryshek.Windows"
        mc:Ignorable="d"
        
        Height="200" Width="900" Background="{StaticResource Akcent}">
    <DockPanel>
        <Border BorderThickness="2" BorderBrush="Black" Margin="2">
        <Image x:Name="Photo"/>
        </Border>
        <Border BorderThickness="2" BorderBrush="Black" Margin="4">
        <StackPanel Orientation="Vertical" MaxWidth="800">
            <TextBlock x:Name="ManeCardText" TextWrapping="Wrap" MaxWidth="500"/>
            <TextBlock x:Name="Opisanie" TextWrapping="Wrap" MaxWidth="500"/>
            <TextBlock x:Name="Proizvoditel" />
            <TextBlock x:Name="Postavshik" />
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="Cena" />
                <TextBlock x:Name="CenaSkidka" />
            </StackPanel>
            <TextBlock x:Name="Edinica" />
            <TextBlock x:Name="Kolichestvo" />
        </StackPanel>
        </Border>
        <Border BorderThickness="2" BorderBrush="Black" Margin="4">
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="Skidka"></TextBlock>
        </Border>
    </DockPanel>
</UserControl>
