<Window x:Class="MirIgryshek.Windows.Auth"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MirIgryshek.Windows"
        mc:Ignorable="d"
        Title="Auth"
        Style="{StaticResource Window}">
    <DockPanel>
        <DockPanel Height="70" DockPanel.Dock="Top">
            <Image Source="/Resources/icon.png"/>
            <TextBlock Style="{StaticResource MenuText}">Мир игрушек</TextBlock>
        </DockPanel>
        <StackPanel Width="400"
                VerticalAlignment="Center"
                Orientation="Vertical">
            <TextBlock>Введите логин</TextBlock>
            <TextBox x:Name="LoginBox"></TextBox>
            <TextBlock>Введите пароль</TextBlock>
            <TextBox x:Name="PasswordBox"></TextBox>

            <Button Style="{StaticResource Button}" x:Name="AuthButton" Click="AuthButton_Click">
                Войти
            </Button>
            <Button Style="{StaticResource Button}" x:Name="GoustButton" Click="GoustButton_Click">
                Войти как гость
            </Button>
        </StackPanel>
    </DockPanel>
</Window>
