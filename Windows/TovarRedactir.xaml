<Window x:Class="MirIgryshek.Windows.TovarRedactir"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MirIgryshek.Windows"
        mc:Ignorable="d"
        Title="TovarRedactir" Style="{StaticResource Window}">
    <ScrollViewer VerticalScrollBarVisibility="Visible">
        <StackPanel Orientation="Vertical">
            <TextBlock>Название</TextBlock>
            <TextBox x:Name="Ima" MaxLength="200"/>
            <TextBlock>Описание</TextBlock>
            <TextBox x:Name="Opisanie" MaxLength="300" />
            <TextBlock>Категория</TextBlock>
            <ComboBox x:Name="Kategoria" DisplayMemberPath="Ima" SelectedValuePath="IdKategoria"></ComboBox>
            <TextBlock>Производитель</TextBlock>
            <ComboBox x:Name="Proizvoditel" DisplayMemberPath="Ima" SelectedValuePath="IdProizvoditel"></ComboBox>
            <TextBlock>Поставщик</TextBlock>
            <ComboBox x:Name="Postavshik" DisplayMemberPath="Ima" SelectedValuePath="IdPostavshik"></ComboBox>
            <TextBlock>Цена</TextBlock>
            <TextBox x:Name="Cena"/>
            <TextBlock>Количество на складе</TextBlock>
            <TextBox x:Name="Kolichestvo"/>
            <TextBlock>Измерение</TextBlock>
            <TextBox x:Name="Izmerenie" MaxLength="5"/>
            <TextBlock>Скидка</TextBlock>
            <TextBox x:Name="Skidka"/>
            <Image x:Name="Photo" Source="/Resources/picture.png" Width="300" Height="200" Stretch="Uniform"/>

            <Button x:Name="PhotoAdd" Style="{StaticResource Button}" Click="PhotoAdd_Click">Выбрать фото</Button>
            <Button x:Name="Save" Style="{StaticResource Button}" Click="Save_Click">Сохранить</Button>
        </StackPanel>
    </ScrollViewer>
</Window>
