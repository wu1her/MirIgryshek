<Window x:Class="MirIgryshek.Windows.Katalog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MirIgryshek.Windows"
        mc:Ignorable="d"
        Title="Каталог"
        Style="{StaticResource Window}">
    <DockPanel >
        <DockPanel Height="70" DockPanel.Dock="Top">
            <Image Source="/Resources/icon.png"/>
            <TextBlock Style="{StaticResource MenuText}">Мир игрушек</TextBlock>
            <TextBlock Style="{StaticResource MenuText}">Каталог</TextBlock>
            <Button Style="{StaticResource Button}" x:Name="Exit" Click="Exit_Click">Выйти</Button>
            <TextBlock Style="{StaticResource MenuText}" x:Name="UserBlock" DockPanel.Dock="Right" Width="350"></TextBlock>
        </DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Height="35" Visibility="Visible" x:Name="Filtr">
            <TextBox Text="Поиск" Width="200" x:Name="Poisk"/>
            <ComboBox x:Name="Filtr_postavshik"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Visible">
            <StackPanel x:Name="Cards">
                
            </StackPanel>
        </ScrollViewer>
    </DockPanel>

</Window>
