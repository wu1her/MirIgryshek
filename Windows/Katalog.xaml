<Window x:Class="MirIgryshek.Windows.Katalog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MirIgryshek.Windows"
        mc:Ignorable="d"
        Title="Каталог"
        Style="{StaticResource Window}" IsVisibleChanged="Window_IsVisibleChanged">
    <DockPanel >
        <DockPanel Height="70" DockPanel.Dock="Top">
            <Image Source="/Resources/icon.png"/>
            <TextBlock Style="{StaticResource MenuText}">Мир игрушек</TextBlock>
            <TextBlock Style="{StaticResource MenuText}">Каталог</TextBlock>
            <Button Style="{StaticResource Button}" x:Name="Exit" Click="Exit_Click">Выйти</Button>
            <Button Style="{StaticResource Button}" x:Name="TovarAdd" Click="TovarAdd_Click" Visibility="Collapsed">Добавление товара</Button>
            <Button Style="{StaticResource Button}" x:Name="Zakazi" Click="Zakazi_Click" Visibility="Collapsed">Заказы</Button>
            <TextBlock Style="{StaticResource MenuText}" x:Name="UserBlock" DockPanel.Dock="Right" Width="350"></TextBlock>
        </DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Height="35" x:Name="Filtr" Visibility="Collapsed">
            <TextBox Width="200" x:Name="Poisk" TextChanged="PoiskVvod"/>
            <ComboBox x:Name="Filtr_postavshik" DisplayMemberPath="Ima" SelectionChanged="FiltrSelect">
            </ComboBox>
            <ComboBox x:Name="Sortirovka" SelectionChanged="FiltrSelect" SelectedIndex="0">
                <ComboBoxItem Content="Цена по возрастанию"/>
                <ComboBoxItem Content="Цена по убыванию"/>
                <ComboBoxItem Content="Склад по возрастанию"/>
                <ComboBoxItem Content="Склад по убыванию"/>
                <ComboBoxItem Content="Без ничего"/>
            </ComboBox>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Visible">
            <StackPanel x:Name="Cards">
                
            </StackPanel>
        </ScrollViewer>
    </DockPanel>

</Window>
