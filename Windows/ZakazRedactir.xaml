<Window x:Class="MirIgryshek.Windows.ZakazRedactir"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказ"
        Width="700" Height="650"
        FontFamily="Arial"
        Background="White">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="15">

            <TextBlock Text="Номер заказа"/>
            <TextBox x:Name="Nomer"
                     IsReadOnly="True"
                     Margin="0,0,0,8"/>

            <TextBlock Text="Пользователь"/>
            <ComboBox x:Name="Polzovatel"
                      DisplayMemberPath="Login"
                      SelectedValuePath="Login"
                      Margin="0,0,0,8"/>

            <TextBlock Text="Статус"/>
            <ComboBox x:Name="Status"
                      DisplayMemberPath="Ima"
                      SelectedValuePath="IdStatus"
                      Margin="0,0,0,8"/>

            <TextBlock Text="Пункт выдачи"/>
            <ComboBox x:Name="Pynkt"
                      DisplayMemberPath="Adres"
                      SelectedValuePath="IdPynkt"
                      Margin="0,0,0,8"/>

            <TextBlock Text="Код получения"/>
            <TextBox x:Name="Kod"
                     Margin="0,0,0,8"/>

            <TextBlock Text="Дата заказа"/>
            <DatePicker x:Name="DataZakaza"
                        Margin="0,0,0,8"/>

            <TextBlock Text="Дата доставки"/>
            <DatePicker x:Name="DataDostavka"
                        Margin="0,0,0,8"/>

            <TextBlock Text="Товары заказа: артикул и количество"/>
            <TextBlock Text="Добавление — в пустой строке. Удаление строки — Delete."
                       Margin="0,0,0,5"/>

            <DataGrid x:Name="Tovary"
                      Height="160"
                      AutoGenerateColumns="False"
                      CanUserAddRows="True"
                      CanUserDeleteRows="True"
                      SelectionUnit="FullRow">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Артикул"
                                        Width="*"
                                        Binding="{Binding Articul}"/>

                    <DataGridTextColumn Header="Количество"
                                        Width="150"
                                        Binding="{Binding Kolichestvo}"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Сохранить"
                        Background="#DEB887"
                        Click="Save_Click"
                        Padding="12,5"
                        Margin="0,0,10,0"/>

                <Button Content="Назад"
                        Click="Back_Click"
                        Padding="12,5"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>