<Application x:Class="MirIgryshek.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MirIgryshek"
             StartupUri="Windows/Auth.xaml">
    <Application.Resources>
        <SolidColorBrush Color="#FFFFFF" x:Key="Osvova"/>
        <SolidColorBrush Color="#F5DEB3" x:Key="Dop"/>
        <SolidColorBrush Color="#DEB887" x:Key="Akcent"/>
        <SolidColorBrush Color="#FFDEAD" x:Key="Skidka"/>

        <Style TargetType="Window" x:Key="Window">
            <Setter Property="Width" Value="900"/>
            <Setter Property="MaxWidth" Value="930"/>
            <Setter Property="MinWidth" Value="870"/>

            <Setter Property="Height" Value="500"/>
            <Setter Property="MaxHeight" Value="530"/>
            <Setter Property="MinHeight" Value="470"/>

            <Setter Property="Background" Value="{StaticResource Osvova}"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>

        <Style TargetType="Button" x:Key="Button">
            <Setter Property="Background" Value="{StaticResource Dop}"/>
            <Setter Property="Margin" Value="10"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="MenuText">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Application.Resources>
</Application>
